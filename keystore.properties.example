# Copy this file as keystore.properties (same folder) and fill it in.
# keystore.properties is in .gitignore: it must NEVER be committed.
#
# Create the key once with Android Studio
# (Build > Generate Signed App Bundle or APK > Create new...)
# or from the command line:
#   keytool -genkeypair -v -keystore ../distilla-upload.jks -alias distilla \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# The path is relative to the project folder; keeping the .jks OUTSIDE the project is safer.
storeFile=../distilla-upload.jks
storePassword=CHANGE_ME
keyAlias=distilla
keyPassword=CHANGE_ME
